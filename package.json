{
  "name": "argus-reader",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build --bundles dmg",
    "format": "prettier --write src tests vite.config.ts index.html package.json tsconfig.json src-tauri/tauri.conf.json src-tauri/capabilities/default.json"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "codemirror": "^6.0.2",
    "diff": "^8.0.4",
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.3.0",
    "parse5": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  },
  "description": "A lightweight macOS Markdown reader and editor",
  "license": "MIT",
  "author": "wylycool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wylycool/argus.git"
  },
  "homepage": "https://github.com/wylycool/argus",
  "bugs": {
    "url": "https://github.com/wylycool/argus/issues"
  }
}
